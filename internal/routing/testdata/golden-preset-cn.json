{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "password": "p1",
      "server": "1.1.1.1",
      "server_port": 443,
      "tag": "hk-01",
      "tls": {
        "enabled": true,
        "server_name": "1.1.1.1"
      },
      "type": "trojan"
    },
    {
      "server": "2.2.2.2",
      "server_port": 443,
      "tag": "us-01",
      "tls": {
        "enabled": true,
        "server_name": "2.2.2.2"
      },
      "type": "vless",
      "uuid": "u2"
    },
    {
      "interval": "300s",
      "outbounds": [
        "hk-01",
        "us-01"
      ],
      "tag": "Auto",
      "type": "urltest",
      "url": "http://www.gstatic.com/generate_204"
    },
    {
      "outbounds": [
        "hk-01",
        "us-01"
      ],
      "tag": "Manual",
      "type": "selector"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-apple",
          "geosite-apple@ads",
          "geosite-apple-dev",
          "geosite-apple-pki",
          "geosite-apple-update"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-google-play"
        ],
        "outbound": "Auto"
      },
      {
        "rule_set": [
          "geosite-google",
          "geoip-google"
        ],
        "outbound": "Auto"
      },
      {
        "rule_set": [
          "acl-BilibiliHMT",
          "acl-Bilibili"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "acl-ChinaIp",
          "acl-ChinaDomain",
          "acl-ChinaCompanyIp",
          "acl-UnBan",
          "acl-SteamCN",
          "acl-Download",
          "acl-ChinaMedia"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-geolocation-!cn",
          "geosite-google",
          "geoip-google",
          "acl-ProxyGFWlist",
          "acl-ProxyMedia"
        ],
        "outbound": "Auto"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "acl-Bilibili",
        "format": "binary",
        "url": "https://github.com/KaringX/karing-ruleset/raw/sing/ACL4SSR/Bilibili.srs"
      },
      {
        "type": "remote",
        "tag": "acl-BilibiliHMT",
        "format": "binary",
        "url": "https://github.com/KaringX/karing-ruleset/raw/sing/ACL4SSR/BilibiliHMT.srs"
      },
      {
        "type": "remote",
        "tag": "acl-ChinaCompanyIp",
        "format": "binary",
        "url": "https://github.com/KaringX/karing-ruleset/raw/sing/ACL4SSR/ChinaCompanyIp.srs"
      },
      {
        "type": "remote",
        "tag": "acl-ChinaDomain",
        "format": "binary",
        "url": "https://github.com/KaringX/karing-ruleset/raw/sing/ACL4SSR/ChinaDomain.srs"
      },
      {
        "type": "remote",
        "tag": "acl-ChinaIp",
        "format": "binary",
        "url": "https://github.com/KaringX/karing-ruleset/raw/sing/ACL4SSR/ChinaIp.srs"
